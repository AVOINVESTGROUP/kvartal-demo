{
  "hosting": {
    "site": "kvartal-web-dev",
    "public": "apps/web/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "apphosting": [
    {
      "backendId": "kvartal-web-dev",
      "rootDirectory": "apps/web"
    },
    {
      "backendId": "fixer-platform-admin-dev",
      "rootDirectory": "apps/platform-admin"
    },
    {
      "backendId": "partner-admin-dev",
      "rootDirectory": "apps/partner-admin"
    },
    {
      "backendId": "kvartal-admin-dev",
      "rootDirectory": "apps/kvartal-admin"
    },
    {
      "backendId": "partner-site-dev",
      "rootDirectory": "apps/partner-site"
    }
  ]
}
