model Organization {
  id                                String                            @id @default(cuid())
  slug                              String                            @unique
  legalName                         String
  countryOfRegistration             String
  operatingCountryCodes             String[]
  defaultLanguage                   LanguageCode                      @default(ru)
  supportedLanguages                LanguageCode[]                    @default([ru])
  defaultCurrency                   CurrencyCode                      @default(USD)
  supportedCurrencies               CurrencyCode[]                    @default([USD])
  status                            LifecycleStatus                   @default(draft)
  subscriptionPlanId                String?
  createdAt                         DateTime                          @default(now())
  updatedAt                         DateTime                          @updatedAt
  offices                           Office[]
  displayNames                      OrganizationLocalization[]
  memberships                       OrganizationMembership[]
  siteConfigs                       SiteConfig[]
  siteObjectVisibilityOverrides     SiteObjectVisibilityOverride[]
  propertyObjects                   PropertyObject[]                  @relation("PropertyOwnerOrganization")
  informationOwnedObjects           PropertyObject[]                  @relation("PropertyInformationOwnerOrganization")
  initiatedPartnerInteractions      PartnerInteraction[]              @relation("PartnerInteractionInitiatingOrganization")
  targetedPartnerInteractions       PartnerInteraction[]              @relation("PartnerInteractionTargetOrganization")
  sentInteractionMessages           InteractionMessage[]              @relation("InteractionMessageSenderOrganization")
  ownedInteractionAttachments       InteractionAttachment[]           @relation("InteractionAttachmentOwnerOrganization")
  interactionTypingStates           InteractionTypingState[]          @relation("InteractionTypingStateOrganization")
  interactionNotificationSettings   InteractionNotificationSetting?
  receivedInteractionNotifications  InteractionNotification[]         @relation("InteractionNotificationRecipientOrganization")
  interactionTemplates              InteractionTemplate[]
  blockedPartners                   BlockedPartner[]                  @relation("BlockedPartnerOrganization")
  blockedByPartners                 BlockedPartner[]                  @relation("BlockedPartnerBlockedOrganization")
  reviewedPartnerReviews            PartnerReview[]                   @relation("PartnerReviewReviewerOrganization")
  receivedPartnerReviews            PartnerReview[]                   @relation("PartnerReviewReviewedOrganization")
  partnerMetrics                    PartnerMetric[]
  clientIntents                     ClientIntent[]
  officeSubscriptions               OfficeSubscription[]
  intakeSubmissions                 PropertyIntakeSubmission[]
  aiDrafts                          PropertyAIDraft[]
  aiExternalChecks                  PropertyAIExternalCheck[]
  propertyAIAnalyses                PropertyObjectAIAnalysis[]
  propertyAIFieldProposals          PropertyObjectAIFieldProposal[]
  legalDocuments                    LegalDocument[]
  propertyRegistrationSubmissions   PropertyRegistrationSubmission[]
  propertyIdentityAuthorityPolicies PropertyIdentityAuthorityPolicy[]
  propertyIdentityRolloutPolicies   PropertyIdentityRolloutPolicy[]
  propertyOriginatorRecords         PropertyOriginatorRecord[]
  propertyRepresentationRights      PropertyRepresentationRight[]
  propertyOffers                    PartnerOffer[]
  publicationSurfaces               PropertyPublicationSurface[]
  publicationGrantsAsSeller         PropertyPublicationGrant[]        @relation("PublicationGrantSellerOrganization")
  publicationGrantsAsBuyer          PropertyPublicationGrant[]        @relation("PublicationGrantBuyerOrganization")
  corporateWallets                  OrganizationCorporateWallet[]
}

model OrganizationLocalization {
  id             String       @id @default(cuid())
  organizationId String
  language       LanguageCode
  displayName    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, language])
}

model Office {
  id                               String                           @id @default(cuid())
  organizationId                   String
  slug                             String
  legalName                        String
  city                             String
  country                          String
  defaultMarketId                  String?
  defaultLanguage                  LanguageCode                     @default(ru)
  supportedLanguages               LanguageCode[]                   @default([ru])
  defaultCurrency                  CurrencyCode                     @default(USD)
  supportedCurrencies              CurrencyCode[]                   @default([USD])
  status                           LifecycleStatus                  @default(draft)
  websiteConfigId                  String?
  createdAt                        DateTime                         @default(now())
  updatedAt                        DateTime                         @updatedAt
  organization                     Organization                     @relation(fields: [organizationId], references: [id])
  defaultMarket                    Market?                          @relation(fields: [defaultMarketId], references: [id])
  displayNames                     OfficeLocalization[]
  memberships                      OfficeMembership[]
  siteConfigs                      SiteConfig[]
  propertyObjects                  PropertyObject[]                 @relation("PropertyOwnerOffice")
  informationOwnedObjects          PropertyObject[]                 @relation("PropertyInformationOwnerOffice")
  initiatedPartnerInteractions     PartnerInteraction[]             @relation("PartnerInteractionInitiatingOffice")
  targetedPartnerInteractions      PartnerInteraction[]             @relation("PartnerInteractionTargetOffice")
  sentInteractionMessages          InteractionMessage[]             @relation("InteractionMessageSenderOffice")
  ownedInteractionAttachments      InteractionAttachment[]          @relation("InteractionAttachmentOwnerOffice")
  interactionTypingStates          InteractionTypingState[]         @relation("InteractionTypingStateOffice")
  receivedInteractionNotifications InteractionNotification[]        @relation("InteractionNotificationRecipientOffice")
  reviewedPartnerReviews           PartnerReview[]                  @relation("PartnerReviewReviewerOffice")
  receivedPartnerReviews           PartnerReview[]                  @relation("PartnerReviewReviewedOffice")
  clientIntents                    ClientIntent[]
  officeSubscriptions              OfficeSubscription[]
  intakeSubmissions                PropertyIntakeSubmission[]
  aiDrafts                         PropertyAIDraft[]
  aiExternalChecks                 PropertyAIExternalCheck[]
  propertyAIAnalyses               PropertyObjectAIAnalysis[]
  legalDocuments                   LegalDocument[]
  propertyRegistrationSubmissions  PropertyRegistrationSubmission[]
  propertyOriginatorRecords        PropertyOriginatorRecord[]
  propertyRepresentationRights     PropertyRepresentationRight[]
  propertyOffers                   PartnerOffer[]
  publicationSurfaces              PropertyPublicationSurface[]
  publicationGrantsAsSeller        PropertyPublicationGrant[]       @relation("PublicationGrantSellerOffice")
  publicationGrantsAsBuyer         PropertyPublicationGrant[]       @relation("PublicationGrantBuyerOffice")

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model OfficeLocalization {
  id          String       @id @default(cuid())
  officeId    String
  language    LanguageCode
  displayName String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  office      Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, language])
}

model Market {
  id                                String                            @id @default(cuid())
  slug                              String                            @unique
  city                              String
  country                           String
  defaultCurrency                   CurrencyCode
  supportedCurrencies               CurrencyCode[]
  supportedLanguages                LanguageCode[]
  assetClasses                      AssetClass[]
  complianceRegion                  String
  active                            Boolean                           @default(true)
  createdAt                         DateTime                          @default(now())
  updatedAt                         DateTime                          @updatedAt
  offices                           Office[]
  propertyObjects                   PropertyObject[]
  clientIntents                     ClientIntent[]
  indicators                        MarketIndicator[]
  insights                          MarketInsight[]
  propertyIdentityAuthorityPolicies PropertyIdentityAuthorityPolicy[]
  propertyIdentityRolloutPolicies   PropertyIdentityRolloutPolicy[]
  propertyRegistrationSubmissions   PropertyRegistrationSubmission[]
}

model AppUser {
  id                                 String                               @id @default(cuid())
  firebaseUid                        String                               @unique
  email                              String                               @unique
  displayName                        String?
  active                             Boolean                              @default(true)
  createdAt                          DateTime                             @default(now())
  updatedAt                          DateTime                             @updatedAt
  platformRoleAssignments            PlatformRoleAssignment[]
  organizationMemberships            OrganizationMembership[]
  officeMemberships                  OfficeMembership[]
  createdPropertyObjects             PropertyObject[]
  createdIntakeSubmissions           PropertyIntakeSubmission[]
  createdAIDrafts                    PropertyAIDraft[]
  uploadedLegalDocuments             LegalDocument[]                      @relation("LegalDocumentUploadedBy")
  uploadedPropertyMedia              PropertyMedia[]                      @relation("PropertyMediaUploadedBy")
  uploadedPropertyDocuments          PropertyDocument[]                   @relation("PropertyDocumentUploadedBy")
  createdPartnerInteractions         PartnerInteraction[]                 @relation("PartnerInteractionCreatedBy")
  sentInteractionMessages            InteractionMessage[]                 @relation("InteractionMessageSender")
  uploadedInteractionAttachments     InteractionAttachment[]              @relation("InteractionAttachmentUploadedBy")
  decidedPropertyAIProposals         PropertyObjectAIFieldProposal[]
  reviewedPartners                   PartnerReview[]                      @relation("PartnerReviewReviewer")
  reviewedLegalDocuments             LegalDocumentReview[]
  auditLogs                          AuditLog[]
  externalIdentities                 AppUserExternalIdentity[]            @relation("ExternalIdentityUser")
  boundExternalIdentities            AppUserExternalIdentity[]            @relation("ExternalIdentityBoundBy")
  revokedExternalIdentities          AppUserExternalIdentity[]            @relation("ExternalIdentityRevokedBy")
  reactivatedExternalIdentities      AppUserExternalIdentity[]            @relation("ExternalIdentityReactivatedBy")
  requestedIdentityBindings          ExternalIdentityBindingRequest[]     @relation("BindingRequestedByUser")
  candidateIdentityBindings          ExternalIdentityBindingRequest[]     @relation("BindingCandidateUser")
  reviewedIdentityBindings           ExternalIdentityBindingRequest[]     @relation("BindingReviewedByUser")
  externalIdentityEvents             ExternalIdentityBindingEvent[]       @relation("BindingEventActorUser")
  bootstrapStates                    ExternalIdentityBootstrapState[]     @relation("BootstrapTargetUser")
  createdPropertyRegistrations       PropertyRegistrationSubmission[]     @relation("PropertyRegistrationCreatedBy")
  createdIdentifierObservations      PropertyIdentifierObservation[]      @relation("PropertyIdentifierObservationCreatedBy")
  propertyIdentityConfirmations      PropertyIdentityAuthorConfirmation[] @relation("PropertyIdentityConfirmedBy")
  propertyIdentityEvents             PropertyIdentityEvent[]              @relation("PropertyIdentityEventActor")
  createdPropertyCanonicalVersions   PropertyCanonicalVersion[]           @relation("PropertyCanonicalVersionCreatedBy")
  requestedCorporateWalletOperations CorporateWalletOperation[]           @relation("CorporateWalletOperationRequestedBy")
  requestedPropertyTokenOperations   PropertyTokenOperation[]             @relation("PropertyTokenOperationRequestedBy")
}

model AppUserExternalIdentity {
  id                    String                           @id @default(cuid())
  appUserId             String
  provider              ExternalIdentityProvider
  subject               String
  status                ExternalIdentityStatus           @default(ACTIVE)
  boundAt               DateTime                         @default(now())
  boundByUserId         String?
  revokedAt             DateTime?
  revokedByUserId       String?
  revocationReason      String?                          @db.Text
  reactivatedAt         DateTime?
  reactivatedByUserId   String?
  rowVersion            Int                              @default(1)
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  appUser               AppUser                          @relation("ExternalIdentityUser", fields: [appUserId], references: [id])
  boundByUser           AppUser?                         @relation("ExternalIdentityBoundBy", fields: [boundByUserId], references: [id], onDelete: SetNull)
  revokedByUser         AppUser?                         @relation("ExternalIdentityRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  reactivatedByUser     AppUser?                         @relation("ExternalIdentityReactivatedBy", fields: [reactivatedByUserId], references: [id], onDelete: SetNull)
  targetBindingRequests ExternalIdentityBindingRequest[]
  events                ExternalIdentityBindingEvent[]
  bootstrapStates       ExternalIdentityBootstrapState[]

  @@unique([provider, subject])
  @@index([appUserId, status])
  @@index([updatedAt, id])
}

model ExternalIdentityBindingRequest {
  id                       String                               @id @default(cuid())
  requestType              ExternalIdentityBindingRequestType
  provider                 ExternalIdentityProvider
  subject                  String
  subjectDigest            String
  verifiedEmail            String?
  emailVerified            Boolean                              @default(false)
  candidateAppUserId       String?
  targetExternalIdentityId String?
  requestedByProvider      ExternalIdentityProvider
  requestedBySubject       String
  requestedBySubjectDigest String
  requestedByAppUserId     String?
  requestedAt              DateTime                             @default(now())
  status                   ExternalIdentityBindingRequestStatus @default(PENDING)
  rowVersion               Int                                  @default(1)
  reviewedByUserId         String?
  reviewedBySubject        String?
  reviewedAt               DateTime?
  reason                   String?                              @db.Text
  expiresAt                DateTime
  createdAt                DateTime                             @default(now())
  updatedAt                DateTime                             @updatedAt
  candidateAppUser         AppUser?                             @relation("BindingCandidateUser", fields: [candidateAppUserId], references: [id], onDelete: SetNull)
  targetExternalIdentity   AppUserExternalIdentity?             @relation(fields: [targetExternalIdentityId], references: [id])
  requestedByAppUser       AppUser?                             @relation("BindingRequestedByUser", fields: [requestedByAppUserId], references: [id], onDelete: SetNull)
  reviewedByUser           AppUser?                             @relation("BindingReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  events                   ExternalIdentityBindingEvent[]

  @@index([requestType, provider, subject, status])
  @@index([requestedAt, id])
  @@index([expiresAt, status])
}

model ExternalIdentityBindingEvent {
  id                 String                           @id @default(cuid())
  eventType          ExternalIdentityBindingEventType
  requestId          String?
  externalIdentityId String?
  actorType          ExternalIdentityAuditActorType
  actorAppUserId     String?
  actorProvider      ExternalIdentityProvider?
  actorSubjectDigest String?
  previousStatus     String?
  nextStatus         String?
  reasonCode         String?
  metadata           Json?
  createdAt          DateTime                         @default(now())
  request            ExternalIdentityBindingRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  externalIdentity   AppUserExternalIdentity?         @relation(fields: [externalIdentityId], references: [id])
  actorAppUser       AppUser?                         @relation("BindingEventActorUser", fields: [actorAppUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([externalIdentityId, createdAt])
  @@index([createdAt])
}

model ExternalIdentityBootstrapState {
  key                String                          @id
  status             ExternalIdentityBootstrapStatus @default(AVAILABLE)
  targetAppUserId    String?
  externalIdentityId String?
  completedAt        DateTime?
  auditEventId       String?
  rowVersion         Int                             @default(1)
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  targetAppUser      AppUser?                        @relation("BootstrapTargetUser", fields: [targetAppUserId], references: [id])
  externalIdentity   AppUserExternalIdentity?        @relation(fields: [externalIdentityId], references: [id])
}

model MutationIdempotency {
  id              String                    @id @default(cuid())
  scope           String                    @unique
  requestHash     String
  status          MutationIdempotencyStatus @default(IN_PROGRESS)
  responseStatus  Int?
  responseBody    Json?
  responseHeaders Json?
  terminalAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([status, terminalAt])
}

model PlatformRoleAssignment {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model OrganizationMembership {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  roles          OrganizationRole[]
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OfficeMembership {
  id             String       @id @default(cuid())
  organizationId String
  officeId       String
  userId         String
  roles          OfficeRole[]
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  office         Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([officeId, userId])
  @@index([organizationId, userId])
}

model SiteConfig {
  id                  String                      @id @default(cuid())
  organizationId      String
  officeId            String
  domain              String?
  subdomain           String?
  defaultLanguage     LanguageCode
  supportedLanguages  LanguageCode[]
  defaultCurrency     CurrencyCode
  supportedCurrencies CurrencyCode[]
  primaryMarketIds    String[]
  showPartnerObjects  Boolean                     @default(true)
  contactEmail        String?
  contactPhone        String?
  active              Boolean                     @default(true)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  organization        Organization                @relation(fields: [organizationId], references: [id])
  office              Office                      @relation(fields: [officeId], references: [id])
  localizations       SiteConfigLocalization[]
  publicationSurface  PropertyPublicationSurface?

  @@index([organizationId])
  @@index([officeId])
}

model SiteConfigLocalization {
  id           String       @id @default(cuid())
  siteConfigId String
  language     LanguageCode
  brandName    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  siteConfig   SiteConfig   @relation(fields: [siteConfigId], references: [id], onDelete: Cascade)

  @@unique([siteConfigId, language])
}

model SiteObjectVisibilityOverride {
  id               String         @id @default(cuid())
  organizationId   String
  propertyObjectId String
  hidden           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
